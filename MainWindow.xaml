<Window x:Class="NovaNet.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NovaNet" xmlns:vm="clr-namespace:NovaNet.ViewModels" xmlns:conv="clr-namespace:NovaNet.Converters" Title="NovaNet" Width="1120" Height="760" MinWidth="980" MinHeight="660" Background="{StaticResource Ink}" Foreground="{StaticResource Text}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen" Icon="Assets/app.ico">
  <Window.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    <conv:EnumToBoolConverter x:Key="EnumToBool"/>
    <conv:LatencyToBrushConverter x:Key="LatencyToBrush"/>
    
    <!-- Target Card Template -->
    <DataTemplate x:Key="TargetCard">
      <Border Style="{StaticResource Card}" Margin="0,0,14,0">
        <StackPanel>
          <TextBlock Text="{Binding Name}" Foreground="{StaticResource Muted}"/>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="{Binding MsText}" Foreground="{Binding MsBrush}" FontFamily="Bahnschrift" FontSize="56" FontWeight="SemiBold"/>
            <TextBlock Text="ms" Foreground="{StaticResource Muted}" FontSize="16" VerticalAlignment="Bottom" Margin="6,0,0,14"/>
          </StackPanel>
          <local:Spark Values="{Binding Series}" Stroke="{Binding MsBrush}" Height="76" Margin="0,6,0,12"/>
          <TextBlock Text="{Binding Stats}" Foreground="{StaticResource Muted}" FontSize="12"/>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- Tweak Row Template -->
    <DataTemplate x:Key="TweakRow">
      <Border Style="{StaticResource Card}" Margin="0,0,12,10" Padding="18,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
              <Border Background="{Binding TagBrush}" CornerRadius="4" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Tag}" FontSize="11" Foreground="#0B0F1A" FontWeight="SemiBold"/>
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,5,24,0"/>
          </StackPanel>
          <CheckBox Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding CanToggle}"/>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- DNS Row Template -->
    <DataTemplate x:Key="DnsRow">
      <Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,12,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding Badge}" Foreground="{StaticResource Mint}" FontWeight="SemiBold" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock Text="{Binding ServersText}" Foreground="{StaticResource Muted}" FontSize="11"/>
          </StackPanel>
          <Border Grid.Column="1" Height="8" CornerRadius="4" Background="{StaticResource Line}" Margin="10,0" VerticalAlignment="Center">
            <Border HorizontalAlignment="Left" Width="{Binding BarWidth}" CornerRadius="4" Background="{StaticResource Amber}"/>
          </Border>
          <TextBlock Grid.Column="2" Text="{Binding Score}" FontFamily="Bahnschrift" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Text}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
          <Button Grid.Column="3" Style="{StaticResource Ghost}" Content="Apply" Padding="12,6" Margin="10,0,0,0" VerticalAlignment="Center" Command="{Binding DataContext.ApplyDnsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding Badge, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Window.DataContext>
    <Binding Path="MainViewModel" Source="{x:Static Application.Current}"/>
  </Window.DataContext>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Top Bar -->
    <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Logo + Title -->
        <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
          <Image Source="Assets/logo.png" Width="32" Height="32" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="NovaNet" FontFamily="Bahnschrift" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
            <TextBlock Text="Internet Optimizer" FontSize="11" Foreground="{StaticResource Muted}"/>
          </StackPanel>
        </StackPanel>

        <!-- Navigation -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <RadioButton Style="{StaticResource Nav}" Content="Live" Tag="Live" IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool}, ConverterParameter=Live, Mode=TwoWay}"/>
          <RadioButton Style="{StaticResource Nav}" Content="Optimize" Tag="Optimize" IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool}, ConverterParameter=Optimize, Mode=TwoWay}"/>
          <RadioButton Style="{StaticResource Nav}" Content="DNS" Tag="Dns" IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool}, ConverterParameter=Dns, Mode=TwoWay}"/>
          <RadioButton Style="{StaticResource Nav}" Content="Network" Tag="Net" IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool}, ConverterParameter=Net, Mode=TwoWay}"/>
          <RadioButton Style="{StaticResource Nav}" Content="Speed" Tag="Speed" IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool}, ConverterParameter=Speed, Mode=TwoWay}"/>
          <RadioButton Style="{StaticResource Nav}" Content="Guide" Tag="Guide" IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool}, ConverterParameter=Guide, Mode=TwoWay}"/>
        </StackPanel>

        <!-- Right side actions -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Style="{StaticResource Ghost}" Content="Theme" Padding="12,6" Margin="0,0,8,0" Command="{Binding ToggleThemeCommand}" ToolTip="Cycle theme: System / Light / Dark"/>
          <Button Style="{StaticResource Ghost}" Content="Settings" Padding="12,6" Margin="0,0,8,0" Command="{Binding OpenSettingsCommand}"/>
          <Button Style="{StaticResource Ghost}" Content="Minimize" Padding="12,6" Command="{Binding MinimizeToTrayCommand}" ToolTip="Minimize to system tray"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Page Content -->
    <Grid Grid.Row="1" Margin="16">
      <!-- LIVE PAGE -->
      <Grid x:Name="PageLive">
        <Grid.Visibility>
          <MultiBinding Converter="{StaticResource BoolToVis}">
            <Binding Path="CurrentPage" Converter="{StaticResource EnumToBool}" ConverterParameter="Live" />
          </MultiBinding>
        </Grid.Visibility>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Verdict Banner -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Connection Quality" FontWeight="SemiBold" FontSize="14"/>
              <TextBlock Text="{Binding LiveVm.Verdict}" Foreground="{Binding LiveVm.VerdictBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Style="{StaticResource Ghost}" Content="Export CSV" Padding="12,6" Margin="0,0,8,0" VerticalAlignment="Center" Command="{Binding LiveVm.ExportHistoryCsvCommand}" ToolTip="Export latency history to CSV"/>
              <Button Style="{StaticResource Ghost}" Content="Clear History" Padding="12,6" Margin="0,0,8,0" VerticalAlignment="Center" Command="{Binding LiveVm.ClearHistoryCommand}"/>
              <Button Style="{StaticResource Ghost}" Content="Refresh" Padding="12,6" VerticalAlignment="Center" Command="{Binding LiveVm.RefreshLinkInfoCommand}"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Link Info -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,16" VerticalAlignment="Top">
          <TextBlock Text="{Binding LiveVm.LinkInfo}" Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="12" LineHeight="22"/>
        </Border>

        <!-- Ping Cards -->
        <ItemsControl Grid.Row="1" Margin="0,100,0,0" ItemsSource="{Binding LiveVm.Targets}" ItemTemplate="{StaticResource TargetCard}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- Add Custom Target -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,14" Margin="0,16,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*" MaxWidth="200"/>
              <ColumnDefinition Width="*" MaxWidth="200"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Add custom target:" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,12,0"/>
            <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" />
            <TextBox Grid.Column="2" Style="{StaticResource ModernTextBox}" />
            <Button Grid.Column="3" Style="{StaticResource Primary}" Content="Add" Padding="16,8" Margin="12,0,0,0" Command="{Binding LiveVm.AddCustomTargetCommand}" CommandParameter="{Binding}"/>
          </Grid>
        </Border>
      </Grid>

      <!-- OPTIMIZE PAGE -->
      <ScrollViewer x:Name="PageOptimize" VerticalScrollBarVisibility="Auto">
        <ScrollViewer.Visibility>
          <MultiBinding Converter="{StaticResource BoolToVis}">
            <Binding Path="CurrentPage" Converter="{StaticResource EnumToBool}" ConverterParameter="Optimize" />
          </MultiBinding>
        </ScrollViewer.Visibility>
        <StackPanel>
          <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,16">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="System Tweaks" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock Foreground="{StaticResource Muted}" Margin="0,4,0,0">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="{}{0} applied, {1} available">
                        <Binding Path="OptimizeVm.AppliedCount" />
                        <Binding Path="OptimizeVm.PendingCount" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource Primary}" Content="Apply All" Padding="16,8" Margin="0,0,10,0" Command="{Binding OptimizeVm.ApplyAllCommand}"/>
              <Button Grid.Column="2" Style="{StaticResource Secondary}" Content="Revert All" Padding="16,8" Command="{Binding OptimizeVm.RevertAllCommand}"/>
            </Grid>
          </Border>
          <ItemsControl ItemsSource="{Binding OptimizeVm.Tweaks}" ItemTemplate="{StaticResource TweakRow}"/>
        </StackPanel>
      </ScrollViewer>

      <!-- DNS PAGE -->
      <ScrollViewer x:Name="PageDns" VerticalScrollBarVisibility="Auto">
        <ScrollViewer.Visibility>
          <MultiBinding Converter="{StaticResource BoolToVis}">
            <Binding Path="CurrentPage" Converter="{StaticResource EnumToBool}" ConverterParameter="Dns" />
          </MultiBinding>
        </ScrollViewer.Visibility>
        <StackPanel>
          <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,16">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="DNS Benchmark" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock Text="Current DNS: {Binding DnsVm.CurrentDns}" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource Primary}" Content="Run Benchmark" Padding="16,8" Command="{Binding DnsVm.RunBenchmarkCommand}"/>
            </Grid>
          </Border>

          <ItemsControl ItemsSource="{Binding DnsVm.DnsResults}" ItemTemplate="{StaticResource DnsRow}"/>

          <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,16,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MaxWidth="200"/>
                <ColumnDefinition Width="*" MaxWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Custom DNS:" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,12,0"/>
              <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding DnsVm.CustomDns1, UpdateSourceTrigger=PropertyChanged}"/>
              <TextBox Grid.Column="2" Style="{StaticResource ModernTextBox}" Text="{Binding DnsVm.CustomDns2, UpdateSourceTrigger=PropertyChanged}"/>
              <Button Grid.Column="3" Style="{StaticResource Primary}" Content="Apply" Padding="16,8" Margin="12,0,10,0" Command="{Binding DnsVm.ApplyCustomDnsCommand}"/>
              <Button Grid.Column="4" Style="{StaticResource Secondary}" Content="Reset to Auto" Padding="16,8" Command="{Binding DnsVm.ResetDnsCommand}"/>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- NETWORK PAGE -->
      <ScrollViewer x:Name="PageNet" VerticalScrollBarVisibility="Auto">
        <ScrollViewer.Visibility>
          <MultiBinding Converter="{StaticResource BoolToVis}">
            <Binding Path="CurrentPage" Converter="{StaticResource EnumToBool}" ConverterParameter="Net" />
          </MultiBinding>
        </ScrollViewer.Visibility>
        <StackPanel>
          <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,16">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Route Doctor" FontWeight="SemiBold" FontSize="16"/>
              <Button Grid.Column="1" Style="{StaticResource Primary}" Content="Run Route Doctor" Padding="16,8" Command="{Binding NetVm.RunRouteDoctorCommand}"/>
            </Grid>
          </Border>

          <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,16">
            <TextBlock Text="{Binding NetVm.RouteReport}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Text}" TextWrapping="Wrap" LineHeight="20"/>
          </Border>

          <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,16">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="MTU Finder" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock Text="{Binding NetVm.MtuResult}" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource Primary}" Content="Find MTU" Padding="16,8" Margin="0,0,10,0" Command="{Binding NetVm.FindMtuCommand}"/>
              <Button Grid.Column="2" Style="{StaticResource Secondary}" Content="Apply MTU" Padding="16,8" Command="{Binding NetVm.ApplyMtuCommand}" IsEnabled="{Binding NetVm.BestMtu, Converter={StaticResource NullToVisibilityConverter}}"/>
            </Grid>
          </Border>

          <Border Style="{StaticResource Card}" Padding="18,14">
            <StackPanel>
              <TextBlock Text="Quick Fixes" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
              <UniformGrid Columns="4" Rows="2">
                <Button Style="{StaticResource Ghost}" Content="Flush DNS" Padding="16,8" Command="{Binding NetVm.FlushDnsCommand}"/>
                <Button Style="{StaticResource Ghost}" Content="Flush ARP/Routes" Padding="16,8" Command="{Binding NetVm.FlushArpCommand}"/>
                <Button Style="{StaticResource Ghost}" Content="Renew IP" Padding="16,8" Command="{Binding NetVm.RenewIpCommand}"/>
                <Button Style="{StaticResource Danger}" Content="Reset Network Stack" Padding="16,8" Command="{Binding NetVm.ResetStackCommand}"/>
                <Button Style="{StaticResource Ghost}" Content="Copy Report" Padding="16,8" Command="{Binding NetVm.CopyReportCommand}"/>
              </UniformGrid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- SPEED PAGE -->
      <Grid x:Name="PageSpeed">
        <Grid.Visibility>
          <MultiBinding Converter="{StaticResource BoolToVis}">
            <Binding Path="CurrentPage" Converter="{StaticResource EnumToBool}" ConverterParameter="Speed" />
          </MultiBinding>
        </Grid.Visibility>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*" MaxHeight="200"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Bufferbloat Test" FontWeight="SemiBold" FontSize="16"/>
            <TextBlock Text="Saturates your line for 10 seconds and watches the ping." Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,18">
          <Button Style="{StaticResource Primary}" Content="Start Test" Padding="16,8" Command="{Binding SpeedVm.StartTestCommand}" IsEnabled="{Binding SpeedVm.IsNotBusy}"/>
          <Button Style="{StaticResource Secondary}" Content="Cancel" Padding="16,8" Margin="10,0,0,0" Command="{Binding SpeedVm.CancelTestCommand}" IsEnabled="{Binding SpeedVm.IsBusy}"/>
          <TextBlock Text="{Binding SpeedVm.ProgressText}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="16,0,0,0"/>
        </StackPanel>
        <ProgressBar Grid.Row="1" Height="6" Margin="0,44,0,0" Value="{Binding SpeedVm.ProgressValue}" Style="{StaticResource ModernProgressBar}"/>

        <UniformGrid Grid.Row="2" Rows="1" Margin="0,0,0,16">
          <Border Style="{StaticResource Card}" Margin="0,0,14,14">
            <StackPanel>
              <TextBlock Text="Download" Foreground="{StaticResource Muted}"/>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SpeedVm.DownloadSpeed}" FontFamily="Bahnschrift" FontSize="40" FontWeight="SemiBold"/>
                <TextBlock Text="Mbps" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="6,0,0,10"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,14,14">
            <StackPanel>
              <TextBlock Text="Upload" Foreground="{StaticResource Muted}"/>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SpeedVm.UploadSpeed}" FontFamily="Bahnschrift" FontSize="40" FontWeight="SemiBold"/>
                <TextBlock Text="Mbps" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="6,0,0,10"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,14,14">
            <StackPanel>
              <TextBlock Text="Idle Ping" Foreground="{StaticResource Muted}"/>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SpeedVm.IdlePing}" FontFamily="Bahnschrift" FontSize="40" FontWeight="SemiBold"/>
                <TextBlock Text="ms" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="6,0,0,10"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,12,14">
            <StackPanel>
              <TextBlock Text="Bufferbloat Grade" Foreground="{StaticResource Muted}"/>
              <TextBlock Text="{Binding SpeedVm.Grade}" FontFamily="Bahnschrift" FontSize="40" FontWeight="SemiBold" Foreground="{Binding SpeedVm.GradeBrush}"/>
            </StackPanel>
          </Border>
        </UniformGrid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,12,0" VerticalAlignment="Top">
          <TextBlock Text="{Binding SpeedVm.DetailText}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="22"/>
        </Border>
      </Grid>

      <!-- GUIDE PAGE -->
      <Grid x:Name="PageGuide">
        <Grid.Visibility>
          <MultiBinding Converter="{StaticResource BoolToVis}">
            <Binding Path="CurrentPage" Converter="{StaticResource EnumToBool}" ConverterParameter="Guide" />
          </MultiBinding>
        </Grid.Visibility>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
          <TextBlock Text="Router Guide" FontFamily="Bahnschrift" FontSize="28" FontWeight="SemiBold"/>
          <TextBlock Foreground="{StaticResource Muted}" Margin="0,6,0,0" Text="For a router doing PPPoE behind a fiber ONT in bridge mode. Menu names vary with firmware."/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding GuideVm.Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}" Margin="0,0,14,10" Padding="18,14">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="{Binding Body}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,5,0,0" LineHeight="20"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>
