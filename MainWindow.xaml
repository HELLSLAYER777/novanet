<Window x:Class="NovaNet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NovaNet"
        Title="NovaNet" Width="1120" Height="760" MinWidth="980" MinHeight="660"
        Background="{StaticResource Ink}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico">

  <Window.Resources>
    <DataTemplate x:Key="TargetCard">
      <Border Style="{StaticResource Card}" Margin="0,0,14,0">
        <StackPanel>
          <TextBlock Text="{Binding Name}" Foreground="{StaticResource Muted}"/>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="{Binding MsText}" Foreground="{Binding MsBrush}" FontFamily="Bahnschrift" FontSize="56" FontWeight="SemiBold"/>
            <TextBlock Text="ms" Foreground="{StaticResource Muted}" FontSize="16" VerticalAlignment="Bottom" Margin="6,0,0,14"/>
          </StackPanel>
          <local:Spark Values="{Binding Series}" Stroke="{Binding MsBrush}" Height="76" Margin="0,6,0,12"/>
          <TextBlock Text="{Binding Stats}" Foreground="{StaticResource Muted}" FontSize="12"/>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="TweakRow">
      <Border Style="{StaticResource Card}" Margin="0,0,12,10" Padding="18,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
              <Border Background="{Binding TagBrush}" CornerRadius="4" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Tag}" FontSize="11" Foreground="#0B0F1A" FontWeight="SemiBold"/>
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,5,24,0"/>
          </StackPanel>
          <CheckBox Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"
                    IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding CanToggle}" Click="Tweak_Click"/>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="DnsRow">
      <Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,12,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding Badge}" Foreground="{StaticResource Mint}" FontWeight="SemiBold" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock Text="{Binding ServersText}" Foreground="{StaticResource Muted}" FontSize="11"/>
          </StackPanel>
          <Border Grid.Column="1" Height="8" CornerRadius="4" Background="{StaticResource Line}" Margin="10,0" VerticalAlignment="Center">
            <Border HorizontalAlignment="Left" Width="{Binding BarWidth}" CornerRadius="4" Background="{StaticResource Amber}"/>
          </Border>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding Score}" FontFamily="Bahnschrift" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="11"/>
          </StackPanel>
          <Button Grid.Column="3" Content="Use" Click="DnsUse_Click" Margin="0"/>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="228"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="18,22">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,30">
          <Image Source="Assets/logo.png" Width="40" Height="40"/>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="NovaNet" FontFamily="Bahnschrift" FontSize="21" FontWeight="SemiBold"/>
            <TextBlock Text="Internet optimizer" Foreground="{StaticResource Muted}" FontSize="11"/>
          </StackPanel>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                   Text="Every change is saved first, so Undo brings back your exact original settings."/>
        <StackPanel>
          <RadioButton Style="{StaticResource Nav}" Content="Live" Tag="Live" IsChecked="True" Checked="Nav_Checked"/>
          <RadioButton Style="{StaticResource Nav}" Content="Optimize" Tag="Optimize" Checked="Nav_Checked"/>
          <RadioButton Style="{StaticResource Nav}" Content="DNS race" Tag="Dns" Checked="Nav_Checked"/>
          <RadioButton Style="{StaticResource Nav}" Content="MTU and routes" Tag="Net" Checked="Nav_Checked"/>
          <RadioButton Style="{StaticResource Nav}" Content="Speed and bufferbloat" Tag="Speed" Checked="Nav_Checked"/>
          <RadioButton Style="{StaticResource Nav}" Content="Router guide" Tag="Guide" Checked="Nav_Checked"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Pages -->
    <Grid Grid.Column="1" Margin="34,28,22,22">

      <!-- LIVE -->
      <Grid x:Name="PageLive">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,22">
          <TextBlock Text="Live connection" FontFamily="Bahnschrift" FontSize="28" FontWeight="SemiBold"/>
          <TextBlock x:Name="Verdict" Foreground="{StaticResource Muted}" Margin="0,6,0,0" Text="Measuring…"/>
        </StackPanel>
        <ItemsControl Grid.Row="1" x:Name="TargetList" ItemTemplate="{StaticResource TargetCard}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,14,0" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Text="Your link" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock x:Name="LinkInfo" Foreground="{StaticResource Muted}" Margin="0,8,0,0" LineHeight="22"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- OPTIMIZE -->
      <Grid x:Name="PageOptimize" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
          <TextBlock Text="Optimize" FontFamily="Bahnschrift" FontSize="28" FontWeight="SemiBold"/>
          <TextBlock Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="Switch tweaks on one by one, or apply them all. Safe ones are reversible and low risk. Advanced ones change your network card and Windows power behavior."/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
          <Button x:Name="BtnSafe" Style="{StaticResource Primary}" Content="Apply safe tweaks" Click="OptimizeSafe_Click"/>
          <Button x:Name="BtnAll" Content="Apply everything (ultra)" Click="OptimizeAll_Click"/>
          <Button x:Name="BtnUndo" Content="Undo all" Click="UndoAll_Click"/>
        </StackPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="TweakList" ItemTemplate="{StaticResource TweakRow}"/>
        </ScrollViewer>
        <TextBox Grid.Row="3" x:Name="LogBox" Height="120" Margin="0,10,12,0" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Background="{StaticResource Panel}" Foreground="{StaticResource Muted}"
                 BorderBrush="{StaticResource Line}" Padding="12,8" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
      </Grid>

      <!-- DNS -->
      <Grid x:Name="PageDns" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
          <TextBlock Text="DNS race" FontFamily="Bahnschrift" FontSize="28" FontWeight="SemiBold"/>
          <TextBlock Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="Every site you open starts with a DNS lookup. This times popular names (cached) and never-seen names (cold) against each resolver, from your line."/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
          <Button x:Name="DnsBtn" Style="{StaticResource Primary}" Content="Start the race" Click="DnsRace_Click"/>
          <Button Content="Back to automatic" Click="DnsReset_Click"/>
          <TextBlock x:Name="DnsStatus" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="DnsList" ItemTemplate="{StaticResource DnsRow}"/>
        </ScrollViewer>
      </Grid>

      <!-- MTU + ROUTES -->
      <Grid x:Name="PageNet" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
          <TextBlock Text="MTU and routes" FontFamily="Bahnschrift" FontSize="28" FontWeight="SemiBold"/>
          <TextBlock Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="PPPoE adds 8 bytes to every packet, so the largest clean packet is usually 1492, not 1500. A wrong MTU causes fragmentation, stalls and odd slow sites."/>
        </StackPanel>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Margin="0,0,14,14" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="MTU finder" FontWeight="SemiBold" FontSize="14"/>
              <TextBlock x:Name="MtuResult" Foreground="{StaticResource Muted}" Margin="0,8,0,14" TextWrapping="Wrap"
                         Text="Sends test packets that are not allowed to fragment and finds the biggest one that gets through."/>
              <Button x:Name="MtuBtn" Style="{StaticResource Primary}" Content="Find best MTU" Click="MtuFind_Click" Margin="0,0,0,10" HorizontalAlignment="Left"/>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="MtuApply" Content="Apply to this PC" Click="MtuApply_Click" IsEnabled="False"/>
                <Button Content="Reset to 1500" Click="MtuReset_Click"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,14">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock Text="Route doctor and repair toolbox" FontWeight="SemiBold" FontSize="14"/>
              <WrapPanel Grid.Row="1" Margin="0,12,0,12">
                <Button Style="{StaticResource Primary}" Content="Scan routes" Click="RouteScan_Click" Margin="0,0,10,8"/>
                <Button Content="Flush DNS" Click="FlushDns_Click" Margin="0,0,10,8"/>
                <Button Content="Clear ARP and route cache" Click="FlushArp_Click" Margin="0,0,10,8"/>
                <Button Content="Renew IP" Click="RenewIp_Click" Margin="0,0,10,8"/>
                <Button Content="Reset Winsock and TCP/IP" Click="ResetStack_Click" Margin="0,0,10,8"/>
              </WrapPanel>
              <TextBox Grid.Row="2" x:Name="RouteOut" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                       Background="{StaticResource Ink}" Foreground="{StaticResource Muted}" BorderBrush="{StaticResource Line}"
                       Padding="12,8" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                       Text="Scan routes to see which adapter carries your traffic and whether the VSOL is really in bridge mode."/>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <!-- SPEED -->
      <Grid x:Name="PageSpeed" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
          <TextBlock Text="Speed and bufferbloat" FontFamily="Bahnschrift" FontSize="28" FontWeight="SemiBold"/>
          <TextBlock Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="Bufferbloat is the extra delay your line adds when it is busy. It is what makes games lag while someone downloads. The test fills your line for 10 seconds each way and watches the ping."/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,18">
          <Button x:Name="SpeedBtn" Style="{StaticResource Primary}" Content="Start test" Click="Speed_Click"/>
          <TextBlock x:Name="SpeedStatus" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
        </StackPanel>
        <UniformGrid Grid.Row="2" Rows="1">
          <Border Style="{StaticResource Card}" Margin="0,0,14,14">
            <StackPanel>
              <TextBlock Text="Download" Foreground="{StaticResource Muted}"/>
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SpDown" Text="–" FontFamily="Bahnschrift" FontSize="40" FontWeight="SemiBold"/>
                <TextBlock Text="Mbps" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="6,0,0,10"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,14,14">
            <StackPanel>
              <TextBlock Text="Upload" Foreground="{StaticResource Muted}"/>
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SpUp" Text="–" FontFamily="Bahnschrift" FontSize="40" FontWeight="SemiBold"/>
                <TextBlock Text="Mbps" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="6,0,0,10"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,14,14">
            <StackPanel>
              <TextBlock Text="Idle ping" Foreground="{StaticResource Muted}"/>
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SpIdle" Text="–" FontFamily="Bahnschrift" FontSize="40" FontWeight="SemiBold"/>
                <TextBlock Text="ms" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="6,0,0,10"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,12,14">
            <StackPanel>
              <TextBlock Text="Bufferbloat grade" Foreground="{StaticResource Muted}"/>
              <TextBlock x:Name="SpGrade" Text="–" FontFamily="Bahnschrift" FontSize="40" FontWeight="SemiBold"/>
            </StackPanel>
          </Border>
        </UniformGrid>
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,12,0" VerticalAlignment="Top">
          <TextBlock x:Name="SpDetail" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="22"
                     Text="Grades: A+ adds under 5 ms when busy, A under 30, B under 60, C under 200. If you land on B or worse, see the Router guide for the QoS fix."/>
        </Border>
      </Grid>

      <!-- GUIDE -->
      <Grid x:Name="PageGuide" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
          <TextBlock Text="Router guide" FontFamily="Bahnschrift" FontSize="28" FontWeight="SemiBold"/>
          <TextBlock Foreground="{StaticResource Muted}" Margin="0,6,0,0" Text="For a Tenda BE3600 doing PPPoE behind a VSOL V2801Q in bridge mode. Menu names vary with firmware."/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="GuidePanel" Margin="0,0,14,0"/>
        </ScrollViewer>
      </Grid>

    </Grid>
  </Grid>
</Window>
