<Window x:Class="NovaNet.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NovaNet" xmlns:conv="clr-namespace:NovaNet.Converters" Title="NovaNet Settings" Width="500" Height="600" WindowStartupLocation="CenterOwner" Background="{StaticResource Ink}" Foreground="{StaticResource Text}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" ResizeMode="NoResize" ShowInTaskbar="False">
  <Window.Resources>
    <conv:EnumToBoolConverter x:Key="EnumToBool"/>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <TextBlock Text="Settings" FontFamily="Bahnschrift" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,24"/>

      <!-- Theme -->
      <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Theme:" VerticalAlignment="Center" Width="120" Foreground="{StaticResource Muted}"/>
            <RadioButton Content="System" GroupName="Theme" IsChecked="{Binding Settings.Theme, Converter={StaticResource EnumToBool}, ConverterParameter=System, Mode=TwoWay}" Margin="0,0,16,0"/>
            <RadioButton Content="Light" GroupName="Theme" IsChecked="{Binding Settings.Theme, Converter={StaticResource EnumToBool}, ConverterParameter=Light, Mode=TwoWay}" Margin="0,0,16,0"/>
            <RadioButton Content="Dark" GroupName="Theme" IsChecked="{Binding Settings.Theme, Converter={StaticResource EnumToBool}, ConverterParameter=Dark, Mode=TwoWay}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Behavior -->
      <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Behavior" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
          <CheckBox Content="Start minimized" IsChecked="{Binding Settings.StartMinimized, Mode=TwoWay}" Margin="0,4"/>
          <CheckBox Content="Minimize to tray" IsChecked="{Binding Settings.MinimizeToTray, Mode=TwoWay}" Margin="0,4"/>
          <CheckBox Content="Close to tray" IsChecked="{Binding Settings.CloseToTray, Mode=TwoWay}" Margin="0,4"/>
          <CheckBox Content="Auto-start monitoring" IsChecked="{Binding Settings.AutoStartMonitoring, Mode=TwoWay}" Margin="0,4"/>
          <CheckBox Content="Enable notifications" IsChecked="{Binding Settings.EnableNotifications, Mode=TwoWay}" Margin="0,4"/>
        </StackPanel>
      </Border>

      <!-- Monitoring -->
      <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Monitoring" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Ping interval (seconds):" VerticalAlignment="Center" Width="180" Foreground="{StaticResource Muted}"/>
            <TextBox Style="{StaticResource ModernTextBox}" Width="80" Text="{Binding Settings.PingIntervalSeconds, Mode=TwoWay}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="History retention (hours):" VerticalAlignment="Center" Width="180" Foreground="{StaticResource Muted}"/>
            <TextBox Style="{StaticResource ModernTextBox}" Width="80" Text="{Binding Settings.HistoryRetentionHours, Mode=TwoWay}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Latency warning (ms):" VerticalAlignment="Center" Width="180" Foreground="{StaticResource Muted}"/>
            <TextBox Style="{StaticResource ModernTextBox}" Width="80" Text="{Binding Settings.LatencyWarningThresholdMs, Mode=TwoWay}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Latency critical (ms):" VerticalAlignment="Center" Width="180" Foreground="{StaticResource Muted}"/>
            <TextBox Style="{StaticResource ModernTextBox}" Width="80" Text="{Binding Settings.LatencyCriticalThresholdMs, Mode=TwoWay}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Updates -->
      <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Updates" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
          <CheckBox Content="Auto-check for updates" IsChecked="{Binding Settings.AutoCheckUpdates, Mode=TwoWay}" Margin="0,4"/>
          <CheckBox Content="Include pre-releases" IsChecked="{Binding Settings.IncludePrereleases, Mode=TwoWay}" Margin="0,4"/>
          <Button Style="{StaticResource Primary}" Content="Check Now" Padding="16,8" Margin="0,8,0,0" HorizontalAlignment="Left" Command="{Binding CheckUpdatesCommand}"/>
        </StackPanel>
      </Border>

      <!-- Data -->
      <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Data" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
          <Button Style="{StaticResource Danger}" Content="Reset All Settings" Padding="16,8" Margin="0,0,10,0" Command="{Binding ResetSettingsCommand}"/>
          <Button Style="{StaticResource Ghost}" Content="Open Data Folder" Padding="16,8" Command="{Binding OpenDataFolderCommand}"/>
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Style="{StaticResource Ghost}" Content="Cancel" Padding="16,8" Margin="0,0,10,0" IsCancel="True"/>
        <Button Style="{StaticResource Primary}" Content="Save" Padding="16,8" IsDefault="True" Click="Save_Click"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
